# Copy to server/.env  (client-only vars go in client/.env, see README)
PORT=3001
NODE_ENV=development
# REQUIRED in production: long random string used to sign auth tokens
JWT_SECRET=change-me-to-a-long-random-string
# Comma separated list of allowed browser origins (only needed if client is hosted separately)
CLIENT_ORIGIN=http://localhost:5173
USERS_FILE=./data/users.json
RECONNECT_GRACE_MS=30000
RESULTS_DELAY_MS=8000
EMPTY_ROOM_TTL_MS=60000
MAX_ROOMS=500
